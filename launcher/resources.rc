// Windows Resource File for RusTale Launcher
#include <windows.h>

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
1 ICON "assets\\logo.ico"

// Version Information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,0,1,0
PRODUCTVERSION  0,0,1,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "RusTale Team"
            VALUE "FileDescription",  "RusTale Game Launcher"
            VALUE "FileVersion",      "0.0.1.0"
            VALUE "InternalName",     "rustale"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "rustale.exe"
            VALUE "ProductName",      "RusTale Launcher"
            VALUE "ProductVersion",   "0.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
